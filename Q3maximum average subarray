class Solution {
public:
    double findMaxAverage(vector<int>& arr, int k) {
        long long sum =0;
        for(int i=0;i<k;i++){
                sum += arr[i];

            }
            long long maxSum = sum;
            for(int i =k;i<arr.size();i++){
                sum += arr[i] - arr[i-k];
                maxSum = max(maxSum,sum);
        }
        return (double)maxSum/k;
    }
};
